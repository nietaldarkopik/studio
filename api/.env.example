APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Keep provider credentials server-side. The default key file is outside this API folder.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY_FILE=../9router-key.txt
NINE_ROUTER_MODEL=Kombo

# Mesin pencari untuk fitur riset (Tavily).
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=6

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blender_automation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Auto production (ide -> upload YouTube) ---
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# Path ke berkas kunci 9Router (relatif ke folder api/). Jangan commit kuncinya.
NINE_ROUTER_API_KEY_FILE=../../9router-key.txt
# Riset: bila kosong, pencarian memakai 9Router /v1/search (Tavily/Exa yang sudah ada di 9Router).
# Isi kunci Tavily sendiri hanya bila ingin memakai langsung.
TAVILY_API_KEY=

# ClipWize (TTS + upload). Token dibuat SEKALI oleh Anda: python clipwize.py login --email <email>
CLIPWIZE_BASES=https://existcode.excoder.site/api,http://localhost:8000/api
CLIPWIZE_TOKEN_FILE=C:\Videos\FaktaUnik\.clipwize_token
CLIPWIZE_ACCOUNT_ID=10
CLIPWIZE_ACCOUNT_NAME="Ternyata Begini"

BLENDER_PATH="C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PRODUCTION_RENDER_FPS=10
PRODUCTION_RENDER_WIDTH=540
PRODUCTION_RENDER_HEIGHT=960

# false = berhenti di QC dan menunggu persetujuan manual sebelum upload (default aman).
# true  = upload YouTube otomatis (PUBLIK) bila QC otomatis lolos.
PRODUCTION_AUTO_PUBLISH=false
PRODUCTION_MAX_POSTS_PER_DAY=1
# Jam produksi harian otomatis (zona Asia/Jakarta), mis. 08:00. Kosong = tidak terjadwal.
PRODUCTION_DAILY_AT=

# false (default) = riset & verifikasi sumber opsional; true = produksi berhenti bila belum ada >=2 sumber lolos fact-check.
PRODUCTION_REQUIRE_RESEARCH=false

# --- Model 3D Sketchfab (opsional) ---
# Buat token di sketchfab.com > Settings > Password & API (akun gratis). Kosong = hanya objek prosedural.
SKETCHFAB_API_TOKEN=
# CC-BY mewajibkan atribusi; kredit otomatis ditulis di deskripsi video.
SKETCHFAB_ALLOWED_LICENSES=cc0,by
SKETCHFAB_MAX_FACES=120000
SKETCHFAB_MAX_DOWNLOAD_MB=80

# --- Poly Pizza (model low-poly gratis; opsional) ---
# Key dari poly.pizza/settings/api. Kosong = tidak dipakai.
POLYPIZZA_API_KEY=
POLYPIZZA_ALLOWED_LICENSES=cc0,by
# Urutan sumber model 3D (yang belum dikonfigurasi dilewati):
PRODUCTION_MODEL_SOURCES=polypizza,sketchfab
